# ============================================================
# AL-FS-01  —  Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit the .env file to version control.
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── LLM Provider ────────────────────────────────────────────
# Supported: openai | azure | local
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o
# For Azure OpenAI (optional)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# ── Target Application ──────────────────────────────────────
APP_URL=https://your-staging-app.example.com

# Credentials per role — add as many ROLE_xxx blocks as needed.
# Format: ROLE_<NAME>_USERNAME / ROLE_<NAME>_PASSWORD
ROLE_ADMIN_USERNAME=
ROLE_ADMIN_PASSWORD=
ROLE_MANAGER_USERNAME=
ROLE_MANAGER_PASSWORD=
ROLE_USER_USERNAME=
ROLE_USER_PASSWORD=

# ── Crawler Configuration ───────────────────────────────────
CRAWL_MAX_DEPTH=5
CRAWL_MAX_PAGES=100
CRAWL_TIMEOUT_MS=30000
CRAWL_SCREENSHOT=true
# Comma-separated list of URL patterns to exclude
CRAWL_EXCLUDE_PATTERNS=logout,delete,remove,payment,destroy
# Comma-separated list of modules to include (empty = all)
CRAWL_INCLUDE_MODULES=

# ── Test Case Configuration ─────────────────────────────────
# Types: positive,negative,boundary,field-validation,role-access,e2e,business-rule
TEST_TYPES=positive,negative,boundary,field-validation,role-access,e2e,business-rule
# Max test cases per requirement
MAX_TESTS_PER_REQUIREMENT=10

# ── Output ───────────────────────────────────────────────────
OUTPUT_DIR=./output
KNOWLEDGE_MODEL_DIR=./data/knowledge
